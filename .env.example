# Environment configuration template.
# The application reads these from the process environment. Export them in your shell, or load them
# with your process manager. This project does not load a .env file automatically.
# Never commit a real .env file.

# Dashboard and API ports (informational; set with: streamlit run --server.port, uvicorn --port)
APP_PORT=8501
API_PORT=8000

# PostgreSQL target for sql/load_to_postgres.py ONLY. The SQLite pipeline always writes data/ecommerce.db.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce_db

# API access control. When API_KEY is set, data endpoints require the X-API-Key header.
# API_KEY=replace_with_a_long_random_value
# Comma-separated browser origins allowed to call the API.
# CORS_ALLOW_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Extra folders the dashboard's "Scan Local Directory" may read (path-separator separated).
# The project data/ directory is always allowed.
# LOCAL_SCAN_ROOTS=/srv/shared/exports

LOG_LEVEL=INFO

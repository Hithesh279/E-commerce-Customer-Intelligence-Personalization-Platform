# Environment Configuration Template
# Copy this file to .env and adjust values as needed. Never commit .env to version control.

# Application Environment (development, staging, production)
APP_ENV=development
APP_PORT=8501
API_PORT=8000

# Database Configuration (defaults to SQLite if not provided)
DATABASE_URL=sqlite:///data/ecommerce.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce_db

# Security & API Secrets
API_SECRET_KEY=change_me_in_production_secret_key_12345
LOG_LEVEL=INFO
